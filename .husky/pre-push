# Keep a feature branch from updating the shared develop branch by mistake.
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/develop" ] && [ "$local_ref" != "refs/heads/develop" ]; then
    printf '%s\n' "Push blocked: $local_ref would update remote develop." >&2
    printf '%s\n' "Push local develop, or select a feature branch on the remote." >&2
    exit 1
  fi
done

exit 0
